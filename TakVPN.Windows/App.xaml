<Application x:Class="TakVPN.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#D4AF37"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#E7C85A"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#B89524"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#232328"/>
  <SolidColorBrush x:Key="WindowBrush" Color="#101012"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#A8AAB3"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#30323A"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Opacity" Value="0.92"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter Property="Opacity" Value="0.78"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.45"/>
     <Setter Property="Cursor" Value="Arrow"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Application.Resources>
</Application>