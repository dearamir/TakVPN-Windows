<Window x:Class="TakVPN.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TakVPN" Height="720" Width="1100" MinHeight="560" MinWidth="760" WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{StaticResource WindowBrush}" FlowDirection="RightToLeft" FontFamily="Segoe UI">
<AdornerDecorator><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,18"><StackPanel><TextBlock Text="TakVPN" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="نسخه ویندوز | پیش‌نمایش اتصال Xray" Foreground="#A8AAB3"/></StackPanel><Border DockPanel.Dock="Left" Background="#292B32" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="Windows 10 / 11 • x64" Foreground="White"/></Border></DockPanel>
<Border x:Name="ConnectionPanel" Grid.Row="1" Background="#101012" CornerRadius="16" Padding="9" Margin="0,0,0,8" BorderBrush="#343B4A" BorderThickness="1">
<Grid ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0"><Button x:Name="ConnectButton" Content="اتصال VPN" Click="Connect_Click" Background="{StaticResource AccentBrush}" FontSize="13" Padding="12,7"/><Button x:Name="DisconnectButton" Content="قطع اتصال" Click="Disconnect_Click" IsEnabled="False" FontSize="13" Padding="12,7"/></StackPanel>
<StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="220">
<TextBlock Text="TakVPN" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
<TextBlock x:Name="AppVersionText" Text="نسخه 0.1.33" Foreground="#AAB5C8" FontSize="11" HorizontalAlignment="Center" Margin="0,1,0,4"/>
<Border x:Name="ConnectionStatusGlow" Background="#202A35" BorderBrush="#4B647C" BorderThickness="1" CornerRadius="20" Padding="12,4" HorizontalAlignment="Center" ClipToBounds="True">
<Grid><TextBlock x:Name="StatusText" Text="قطع" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
<Border x:Name="StatusShine" Width="70" HorizontalAlignment="Left" Opacity="0.75" IsHitTestVisible="False">
<Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#BFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
<Border.RenderTransform><TranslateTransform x:Name="ShineTransform" X="-100"/></Border.RenderTransform>
<Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="ShineTransform" Storyboard.TargetProperty="X" From="-100" To="300" Duration="0:0:2.4"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
</Border></Grid>
</Border>
<TextBlock x:Name="StatusHint" Text="برای اتصال، یک کانفیگ انتخاب کنید." Foreground="#A8AAB3" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
</StackPanel>
<TextBlock Grid.Column="2" Text="وضعیت اتصال" Foreground="#A8AAB3" VerticalAlignment="Center" Margin="12,0,4,0"/>
</Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border x:Name="ConfigPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="11" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,12"><TextBlock Text="کانفیگ‌های من" Foreground="White" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="ConfigInput" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" Background="#101012" Foreground="White" BorderBrush="#444650" CaretBrush="White" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="یک یا چند لینک کانفیگ را در خط‌های جداگانه وارد یا جای‌گذاری کنید"/><WrapPanel x:Name="ConfigToolbar" AllowDrop="True" HorizontalAlignment="Left" Margin="0,8,0,10"><Button Content="افزودن تکی / گروهی" Click="AddConfig_Click" Background="{StaticResource AccentBrush}"/><Button Content="ویرایش کانفیگ" Click="EditConfig_Click"/><Button Content="حذف انتخاب‌شده" Click="RemoveConfig_Click"/><Button x:Name="TestButton" Content="تست این کانفیگ" Click="TestLatency_Click"/><Button x:Name="TestAllButton" Content="پینگ همه" Click="TestAll_Click"/><Button Content="مرتب‌سازی پینگ ↑" Click="SortByPing_Click" ToolTip="مرتب‌سازی بر اساس پینگ از کم به زیاد"/><Button x:Name="CheckXrayButton" Content="بررسی موتور Xray" Click="CheckXray_Click" ToolTip="بررسی فایل هسته Xray و Wintun و اجرای تست نسخه"/></WrapPanel></StackPanel><ListBox x:Name="ProfilesList" Background="#17181D" Foreground="White" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#292A30"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#332D1B"/><Setter Property="BorderBrush" Value="#D4AF37"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#353741" BorderThickness="0,0,0,1" Padding="8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding ProtocolDisplay}" Foreground="#D4AF37" FontSize="10"/><TextBlock Text="{Binding CompactLine}" Foreground="#BFC2CB" FontSize="10" TextTrimming="WordEllipsis" FlowDirection="LeftToRight"/><Button Content="پینگ" Tag="{Binding}" Click="TestProfile_Click" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border x:Name="DetailsPanel" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="14" Margin="8,0,0,0">
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
<StackPanel>
<TextBlock Text="جزئیات کانفیگ" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="نام" Foreground="#A8AAB3" FontSize="11"/><TextBlock x:Name="DetailName" Text="—" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="پروتکل" Foreground="#A8AAB3" FontSize="11"/><TextBlock x:Name="DetailProtocol" Text="—" Foreground="White" Margin="0,2,0,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="آدرس سرور" Foreground="#A8AAB3" FontSize="11"/><TextBlock x:Name="DetailHost" Text="—" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0" FlowDirection="RightToLeft" TextAlignment="Right"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="IP سرور / کشور" Foreground="#A8AAB3" FontSize="11"/><TextBlock x:Name="DetailServerLocation" Text="—" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="پورت" Foreground="#A8AAB3" FontSize="11"/><TextBlock x:Name="DetailPort" Text="—" Foreground="White" Margin="0,2,0,0"/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="تأخیر تونل" Foreground="#A8AAB3" FontSize="11"/><Border x:Name="LatencyClickArea" Background="Transparent" Cursor="Hand" ToolTip="برای اندازه‌گیری مجدد تأخیر واقعی کلیک کنید" MouseLeftButtonUp="DetailLatency_Click"><TextBlock x:Name="DetailLatency" Text="اندازه‌گیری نشده" Foreground="#E4C15A" FontSize="16" Margin="0,2,0,0" TextDecorations="Underline"/></Border></StackPanel>
</Grid>
<Border Background="#232328" CornerRadius="10" Padding="10" Margin="0,2,0,8"><StackPanel><TextBlock Text="تمام جزئیات و پارامترهای کانفیگ" Foreground="#A8AAB3" FontWeight="SemiBold" Margin="0,0,0,6"/><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><TextBlock x:Name="DetailFullConfig" Text="—" Foreground="#D7D9E0" FontSize="11" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Left" FontFamily="Consolas"/></ScrollViewer></StackPanel></Border><Border Background="#232328" CornerRadius="10" Padding="10" Margin="0,2,0,8"><StackPanel><TextBlock Text="ترافیک اتصال" Foreground="#A8AAB3" FontWeight="SemiBold" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="↑ ارسال" Foreground="#77D6A5" FontSize="11"/><TextBlock x:Name="DetailSendTotal" Text="0 B" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="DetailSendRate" Text="0 B/s" Foreground="#A8AAB3" FontSize="11"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="↓ دریافت" Foreground="#70B9FF" FontSize="11"/><TextBlock x:Name="DetailReceiveTotal" Text="0 B" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="DetailReceiveRate" Text="0 B/s" Foreground="#A8AAB3" FontSize="11"/></StackPanel></Grid><TextBlock x:Name="DetailTotalTraffic" Text="مجموع مصرف: 0 B" Foreground="#E4C15A" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
<TextBlock Text="اتصال از طریق Xray و رابط Wintun انجام می‌شود. برای ساخت تونل و تنظیم مسیرهای شبکه، اجرای برنامه با دسترسی مدیر لازم است." Foreground="#A8AAB3" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,6"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="1" Background="#101012" CornerRadius="9" Padding="9" Margin="0,8,0,0"><DockPanel><TextBlock Text="گزارش زنده اتصال" Foreground="#A8AAB3" FontWeight="SemiBold" Margin="0,0,0,6" DockPanel.Dock="Top"/><TextBox x:Name="LogsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111216" Foreground="#BFC2CB" BorderThickness="0" FontFamily="Consolas" FontSize="10" FlowDirection="LeftToRight"/></DockPanel></Border>
</Grid></Border>
</Grid><Border x:Name="FooterPanel" Grid.Row="3" Background="#101012" BorderBrush="#343B4A" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="ThemeToggleButton" Content="تغییر پوسته" Click="ThemeToggle_Click" ToolTip="تغییر بین پوسته مشکی‌طلایی و آبی اقیانوسی"/><Button x:Name="EditLayoutButton" Content="ویرایش چیدمان" ToolTip="جابه‌جایی و تغییر اندازه پنل‌ها و مرتب‌سازی دکمه‌ها"/><Button x:Name="ResetLayoutButton" Content="بازنشانی چیدمان" Visibility="Collapsed"/><Button x:Name="CheckUpdateButton" Content="بررسی بروزرسانی" Click="CheckForUpdates_Click" Padding="12,7" Background="{StaticResource AccentBrush}"/><Button x:Name="InstallUpdateButton" Content="دانلود و نصب بروزرسانی" Click="InstallUpdate_Click" Padding="12,7" Visibility="Collapsed"/></StackPanel><StackPanel VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock x:Name="UpdateStatusText" Text="TakVPN • Windows client" Foreground="#A8AAB3" FontSize="11" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,5,0,0"/></StackPanel></DockPanel></Border></Grid></AdornerDecorator></Window>